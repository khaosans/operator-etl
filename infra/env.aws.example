# AWS L2 deployment environment (ECS + S3 + RDS)
# Warehouse stays DuckDB until a later warehouse lift.

OPERATOR_ETL_BACKEND=duckdb
OPERATOR_ETL_DOMAIN=gov
OPERATOR_ETL_PIPELINE_NAME=public_comments

OPERATOR_ETL_OBJECT_STORE_BACKEND=s3
OPERATOR_ETL_INBOX_URI=s3://YOUR_INBOX_BUCKET/incoming/
OPERATOR_ETL_AWS_REGION=us-east-1
# OPERATOR_ETL_S3_INBOX_BUCKET=YOUR_INBOX_BUCKET

OPERATOR_ETL_CHECKPOINT_BACKEND=postgres
OPERATOR_ETL_CHECKPOINT_DATABASE_URL=postgresql://graph_runner:PASSWORD@RDS_HOST:5432/operator_etl

OPERATOR_ETL_INSIGHT_BACKEND=template

PII_VAULT_KEY=replace-with-32-byte-key
OPENAI_API_KEY=optional-for-llm-nodes
