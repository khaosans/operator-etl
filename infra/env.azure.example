# Azure L2 deployment environment (Container Apps + Blob + Postgres)
# Warehouse stays DuckDB until a later warehouse lift.

OPERATOR_ETL_BACKEND=duckdb
OPERATOR_ETL_DOMAIN=gov
OPERATOR_ETL_PIPELINE_NAME=public_comments

OPERATOR_ETL_OBJECT_STORE_BACKEND=azure
OPERATOR_ETL_INBOX_URI=az://YOUR_STORAGE_ACCOUNT/inbox/incoming
OPERATOR_ETL_AZURE_STORAGE_ACCOUNT=YOUR_STORAGE_ACCOUNT
OPERATOR_ETL_AZURE_INBOX_CONTAINER=inbox

OPERATOR_ETL_CHECKPOINT_BACKEND=postgres
OPERATOR_ETL_CHECKPOINT_DATABASE_URL=postgresql://graph_runner:PASSWORD@PG_FQDN:5432/operator_etl

OPERATOR_ETL_INSIGHT_BACKEND=template

PII_VAULT_KEY=replace-with-32-byte-key
OPENAI_API_KEY=optional-for-llm-nodes
