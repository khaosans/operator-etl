# Cloud / portable deployment environment
# Same contract on GCP, AWS, Azure, or Kubernetes — provider fields are optional.

# Warehouse: duckdb (local/ephemeral) or bigquery (GCP reference adapter)
OPERATOR_ETL_BACKEND=bigquery
OPERATOR_ETL_DOMAIN=gov
OPERATOR_ETL_PIPELINE_NAME=public_comments

# Object-store inbox (portable)
# OPERATOR_ETL_OBJECT_STORE_BACKEND=gcs
# OPERATOR_ETL_INBOX_URI=gs://operator-etl-staging-inbox-your-gcp-project-id/incoming

# GCP reference adapter (when using BigQuery / GCS)
OPERATOR_ETL_GCP_PROJECT=your-gcp-project-id
OPERATOR_ETL_GCP_REGION=us-central1
OPERATOR_ETL_GCS_INBOX_BUCKET=operator-etl-staging-inbox-your-gcp-project-id
OPERATOR_ETL_BQ_DATASET_BRONZE=etl_bronze_staging
OPERATOR_ETL_BQ_DATASET_SILVER=etl_silver_staging
OPERATOR_ETL_BQ_DATASET_QUARANTINE=etl_quarantine_staging
OPERATOR_ETL_BQ_DATASET_GOLD=etl_gold_staging

# Checkpoints — any managed Postgres (Cloud SQL, RDS, Azure Database, …)
OPERATOR_ETL_CHECKPOINT_BACKEND=postgres
OPERATOR_ETL_CHECKPOINT_DATABASE_URL=postgresql://graph_runner:PASSWORD@HOST:5432/operator_etl

# Optional LLM insights (keep template until OPENAI_API_KEY is a real secret)
# OPERATOR_ETL_INSIGHT_BACKEND=llm
# OPERATOR_ETL_LLM_MODEL=gpt-4o-mini

# Secrets (mount from your cloud secret store)
PII_VAULT_KEY=replace-with-32-byte-key
OPENAI_API_KEY=optional-for-llm-nodes
