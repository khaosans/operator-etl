# Local MVP (DuckDB) — copy to .env and adjust paths
# GCP deployment: see infra/env.example

OPERATOR_ETL_WAREHOUSE=warehouse/operator.duckdb
OPERATOR_ETL_PIPELINE_NAME=public_comments
OPERATOR_ETL_DOMAIN=gov
OPERATOR_ETL_BACKEND=duckdb

# Optional thresholds
# OPERATOR_ETL_MAX_QUARANTINE_RATE=0.35
# OPERATOR_ETL_MAX_FRESHNESS_HOURS=168

# Optional LLM insights (default is template — no API key required)
# uv sync --extra llm --extra dev
# OPERATOR_ETL_INSIGHT_BACKEND=llm
# OPERATOR_ETL_LLM_MODEL=gpt-4o-mini
# OPERATOR_ETL_LLM_BASE_URL=http://127.0.0.1:1234/v1
# OPENAI_API_KEY=sk-...
