# Local MVP (DuckDB) — copy to .env and adjust paths
# GCP deployment: see infra/env.example

OPERATOR_ETL_WAREHOUSE=warehouse/operator.duckdb
OPERATOR_ETL_PIPELINE_NAME=public_comments
OPERATOR_ETL_DOMAIN=gov
OPERATOR_ETL_BACKEND=duckdb

# Optional thresholds
# OPERATOR_ETL_MAX_QUARANTINE_RATE=0.35
# OPERATOR_ETL_MAX_FRESHNESS_HOURS=168

# Optional LLM insights (default is template — no API key required)
# Install + cards: docs/LLM.md · docs/MODELS.md
# Data boundary (gold JSON on-box vs OpenAI): docs/NIST.md
# uv sync --extra llm --extra dev
# OPERATOR_ETL_INSIGHT_BACKEND=llm
# Ollama (OpenAI-compatible; JSON stays local):
# OPERATOR_ETL_LLM_BASE_URL=http://127.0.0.1:11434/v1
# OPERATOR_ETL_LLM_MODEL=llama3.2:3b
# Cloud / hosted (gold KPI JSON leaves the box):
# OPERATOR_ETL_LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...

# Optional observability
# OTEL_SERVICE_NAME=operator-etl
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# LANGCHAIN_TRACING_V2=false

# A2A HTTP bearer auth
# OPERATOR_ETL_A2A_BEARER_TOKEN=change-me

# Separate orders warehouse so Streamlit Gov + Orders tabs both work
# OPERATOR_ETL_ORDERS_WAREHOUSE=.tmp/orders-demo/operator.duckdb
