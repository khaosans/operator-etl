# Python / uv
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
src/*.egg-info/
dist/
build/

# Local secrets and env
.env
.env.*
!.env.example

# Runtime data (warehouse, drops, demo)
warehouse/*
!warehouse/.gitkeep
drops/inbox/*
!drops/inbox/.gitkeep
.tmp/

# Harness / agent session artifacts
features.json
claude-progress.txt
init.sh
e2e-local.sh

# Terraform — state and secrets (commit .terraform.lock.hcl after terraform init)
infra/terraform/.terraform/
infra/terraform/*.tfstate
infra/terraform/*.tfstate.*
infra/terraform/terraform.tfvars
infra/terraform/crash.log
infra/terraform/override.tf
infra/terraform/*_override.tf

# IDE / OS
.DS_Store
.idea/
.vscode/
*.swp
Thumbs.db

# Cursor — local MCP config (commit .example only)
.cursor/mcp.json

# Test / coverage
.coverage
.coverage.*
htmlcov/
*.log

# Share pack dated archives (latest/ is committed)
docs/share/releases/
